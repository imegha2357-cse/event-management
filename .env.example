# --- Database: Neon URL (production) or any Postgres URL (local development) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/eventdesk?sslmode=require

# --- Sign-in (Auth.js) ---
# Generate with:  openssl rand -base64 32
AUTH_SECRET=
# Your live site address, e.g. https://eventdesk.<your-subdomain>.workers.dev
AUTH_URL=
# Google sign-in: Google Cloud Console > APIs & Services > Credentials > OAuth client (Web)
# Authorised redirect URI:  <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Password reset emails (Resend, https://resend.com) ---
RESEND_API_KEY=
EMAIL_FROM=EventDesk <no-reply@yourdomain.com>

# --- WhatsApp Business (Meta WhatsApp Cloud API) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved message template (see README for the exact text)
WHATSAPP_TEMPLATE_NAME=booking_confirmation
WHATSAPP_TEMPLATE_LANG=en

# --- Scheduled retries (the Cloudflare cron trigger sends this as a Bearer token) ---
CRON_SECRET=
